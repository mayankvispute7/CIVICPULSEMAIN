# Civic Pulse Backend Environment Variables

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/civicpulse
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/civicpulse_test

# Use SQLite for development without PostgreSQL/PostGIS
# Set to "true" to use SQLite instead of PostgreSQL
USE_SQLITE=true

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true
LOG_LEVEL=info

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# File uploads
MAX_CSV_SIZE_MB=50
MAX_CSV_ROWS=10000
UPLOAD_DIR=./uploads

# LLM Provider (optional - system works without it)
# LLM_PROVIDER=openai
# LLM_API_KEY=
# LLM_MODEL=gpt-4

# Earth Observation (optional - uses mock by default)
# EO_PROVIDER=copernicus
# EO_API_KEY=

# Weather/Rainfall (optional - uses mock by default)
# WEATHER_PROVIDER=openmeteo
# WEATHER_API_KEY=

# Geocoding (optional - uses mock by default)
# GEOCODING_PROVIDER=nominatim
# GEOCODING_API_KEY=

# Clustering
CLUSTERING_MIN_SAMPLES=2
CLUSTERING_SPATIAL_EPS_METERS=500
CLUSTERING_TEMPORAL_DAYS=90

# Demo seed
DEMO_SEED=42
